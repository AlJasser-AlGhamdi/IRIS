#!/bin/sh
# Refuse a commit that would publish a secret, a private address, a personal path or NCA text.
uv run python scripts/public_check.py >/tmp/public_check.out 2>&1
status=$?
if [ $status -ne 0 ]; then
  cat /tmp/public_check.out
  echo "pre-commit: public_check found problems; nothing was committed." >&2
fi
exit $status
